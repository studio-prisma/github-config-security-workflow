# Permanent CRLF-drift fix for cross-OS checkouts.
# Without this, `.github/workflows/*.yml` (and any LF-checked-in file) flips to CRLF
# on Windows clones and shows up as phantom-modified in `git status`.

# Default: let git detect text vs. binary, force LF on commit + checkout for text files.
* text=auto eol=lf

# Explicit overrides — always LF (even on Windows checkout).
*.md      text eol=lf
*.php     text eol=lf
*.py      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.txt     text eol=lf

# Shell scripts must stay LF and executable.
*.sh      text eol=lf

# Explicit binary (no EOL handling).
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.svg     text eol=lf

# Keep development-only paths out of the source archive.
/tests/       export-ignore
/docs/        export-ignore
# .github/actions/ must stay in the archive: the runner downloads a composite
# action as a source archive, export-ignore would hide action.yml from it.
/.github/workflows/      export-ignore
/.github/ISSUE_TEMPLATE/ export-ignore
/.github/PULL_REQUEST_TEMPLATE.md export-ignore
/.github/dependabot.yml  export-ignore
/.gitattributes export-ignore
/.gitignore   export-ignore
